<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Panel — DANA</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'hoy' }) %>

    <main class="main">
      <div class="topbar">
        <div>
          <p class="eyebrow">Panel de control</p>
          <h1 id="saludo">Hola</h1>
          <p class="topbar-sub">Hoy es <span id="fecha-larga">—</span></p>
        </div>
        <div class="topbar-right">
          <div class="clock-widget">
            <div class="clock-face">
              <div class="clock-hand hour" id="hand-hour"></div>
              <div class="clock-hand minute" id="hand-minute"></div>
              <div class="clock-hand second" id="hand-second"></div>
              <div class="clock-dot"></div>
            </div>
            <div>
              <span class="clock-digital" id="clock-digital">--:--:--</span>
              <span class="clock-date" id="clock-date">—</span>
            </div>
          </div>
          <div class="empresa-chip">
            <div class="avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="10" height="18" rx="1"/><path d="M14 8h6v13h-6"/><path d="M7.5 7h1M11 7h1M7.5 11h1M11 11h1M7.5 15h1M11 15h1"/></svg></div>
            <span><%= empresaNombre %></span>
          </div>
        </div>
      </div>

      <div class="qr-hero">
        <div class="card qr-card">
          <div class="pill pill-active">Código activo</div>
          <h2 style="margin-top:12px;">Código de hoy (<span id="fecha-hoy">—</span>)</h2>
          <p class="card-sub">Los trabajadores escanean este QR para marcar su asistencia</p>
          <div class="qr-frame">
            <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
            <img id="qr-img" class="qr-image qr-image-lg" src="/api/admin/qr/today.png" alt="Codigo QR del dia" />
          </div>
          <div class="token-url" id="url-checkin">—</div>
          <button id="regenerar-btn" class="secundario">Invalidar y generar nuevo código</button>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <h2>Asistencia de hoy</h2>
          <span class="pill" style="background:var(--blue-light); color:var(--blue-dark);" id="contador-hoy">0 registros</span>
        </div>
        <div style="overflow-x:auto;">
          <table>
            <thead>
              <tr><th>Nombre</th><th>DNI</th><th>Entrada</th><th>Salida</th></tr>
            </thead>
            <tbody id="tabla-hoy">
              <tr><td colspan="4">Cargando...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/admin-dashboard.js"></script>
</body>
</html>
