<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Panel — DANA</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('../partials/header', {
    navHome: '/admin',
    navLinks: [
      { href: '/admin', texto: 'Hoy' },
      { href: '/admin/historial', texto: 'Historial' },
      { href: '/admin/trabajadores', texto: 'Trabajadores' },
      { href: '#', texto: 'Salir', id: 'logout-link' }
    ],
    logoEmpresaUrl: logoEmpresaUrl
  }) %>

  <div class="contenedor-ancho">
    <div class="tarjeta" style="text-align:center;">
      <h2>Código de hoy (<span id="fecha-hoy">—</span>)</h2>
      <div class="qr-marco">
        <div class="qr-marco-etiqueta">Registro de asistencia</div>
        <img id="qr-img" class="qr-imagen" src="/api/admin/qr/today.png" alt="Codigo QR del dia" />
        <div class="qr-marco-sello"><img src="/dana.png" alt="Dana" /></div>
      </div>
      <div class="token-url" id="url-checkin">—</div>
      <div class="fila-acciones" style="justify-content:center;">
        <button id="regenerar-btn" class="secundario">Invalidar y generar nuevo código</button>
      </div>
    </div>

    <div class="tarjeta">
      <h2>Logo de tu empresa</h2>
      <p class="subtitulo">Aparece a la derecha del logo de DANA en la parte superior del panel. Formatos: PNG, JPG, WEBP o SVG, máximo 2MB.</p>
      <div class="fila-acciones">
        <img id="logo-preview" src="<%= logoEmpresaUrl %>" alt="" style="height:40px; max-width:160px; object-fit:contain;" onerror="this.style.display='none'" />
        <input type="file" id="logo-input" accept="image/png,image/jpeg,image/webp,image/svg+xml" />
        <button id="logo-btn" class="secundario">Subir logo</button>
      </div>
      <div id="logo-error"></div>
    </div>

    <div class="tarjeta">
      <h2>Asistencia de hoy <span id="contador-hoy" style="color:var(--muted); font-family:var(--font-mono); text-transform:none; letter-spacing:0;"></span></h2>
      <table>
        <thead>
          <tr><th>Nombre</th><th>DNI</th><th>Entrada</th><th>Salida</th></tr>
        </thead>
        <tbody id="tabla-hoy">
          <tr><td colspan="4">Cargando...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script src="/js/admin-dashboard.js"></script>
</body>
</html>
