<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Horario — DANA</title>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'trabajadores' }) %>

    <main class="main" id="app" data-worker-id="<%= worker.id %>" data-fecha-ingreso="<%= worker.fecha_ingreso ? new Date(worker.fecha_ingreso).toISOString().slice(0, 10) : '' %>">
      <a href="/admin/trabajadores" class="back-link">← Volver a trabajadores</a>

      <div class="topbar">
        <div>
          <p class="eyebrow">Trabajador</p>
          <h1>Horario de <%= worker.nombre %></h1>
          <p class="topbar-sub">Cada horario aplica desde una fecha. Al agregar uno nuevo, el anterior se mantiene para las fechas previas.</p>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <h2 style="margin:0;">Horarios</h2>
          <button type="button" id="nuevo-horario-btn">+ Nuevo horario</button>
        </div>
        <p class="card-sub">Las horas extra, tardanzas e inasistencias de cada día se calculan con el horario vigente en esa fecha, y se recalculan solas cuando cambias un horario.</p>
        <div style="overflow-x:auto;">
          <table>
            <thead><tr><th>Aplica desde</th><th>Tipo</th><th>Detalle</th><th>Estado</th><th></th></tr></thead>
            <tbody id="tabla-versiones">
              <tr><td colspan="5">Cargando...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card" id="editor" hidden>
        <h2 id="editor-titulo">Nuevo horario</h2>
        <div id="editor-error"></div>
        <div class="fila-acciones">
          <label style="margin:0;">Aplica desde
            <input type="date" id="vigente-desde-input" style="max-width:180px; margin:0;" />
          </label>
          <label style="margin:0; font-weight:500; text-transform:none;">
            <input type="radio" name="tipo-horario" value="semanal" /> Semanal
          </label>
          <label style="margin:0; font-weight:500; text-transform:none;">
            <input type="radio" name="tipo-horario" value="rotativo" /> Rotativo
          </label>
        </div>

        <div id="bloque-semanal" hidden>
          <table>
            <thead><tr><th>Día</th><th>Libre</th><th>Entrada</th><th>Salida</th></tr></thead>
            <tbody id="tabla-semanal"></tbody>
          </table>
        </div>

        <div id="bloque-rotativo" hidden>
          <label style="margin:0 0 12px; display:block;">Fecha ancla del ciclo (día 1 del patrón)
            <input type="date" id="ancla-input" style="max-width:180px;" />
          </label>
          <p class="card-sub" style="margin-bottom:8px;">Secuencia de pasos — se repite cada N días (N = cantidad de pasos que agregues):</p>
          <div id="pasos-container" style="display:flex; flex-direction:column; gap:8px; margin-bottom:12px;"></div>
          <button type="button" id="agregar-paso-btn" class="secundario">+ Agregar paso</button>
        </div>

        <div class="fila-acciones" style="margin-top:14px; margin-bottom:0;">
          <button type="button" id="guardar-horario-btn">Guardar horario</button>
          <button type="button" id="cancelar-horario-btn" class="secundario">Cancelar</button>
        </div>
      </div>

      <div class="card">
        <h2>Excepciones puntuales</h2>
        <p class="card-sub">Para un día específico (permiso, cambio de turno de último momento), sin romper el patrón general.</p>
        <div id="excepcion-error"></div>
        <form id="excepcion-form" class="fila-acciones">
          <input type="date" id="exc-fecha" required style="max-width:150px; margin:0;" />
          <label style="margin:0; font-weight:500; text-transform:none;">
            <input type="checkbox" id="exc-libre" /> Libre
          </label>
          <select id="exc-plantilla" style="max-width:200px; margin:0;">
            <option value="">(horario ad-hoc)</option>
          </select>
          <input type="time" id="exc-entrada" style="margin:0;" />
          <input type="time" id="exc-salida" style="margin:0;" />
          <input type="text" id="exc-motivo" placeholder="Motivo (opcional)" style="max-width:180px; margin:0;" />
          <button type="submit">Agregar excepción</button>
        </form>
        <table>
          <thead><tr><th>Fecha</th><th>Detalle</th><th>Motivo</th><th></th></tr></thead>
          <tbody id="tabla-excepciones">
            <tr><td colspan="4">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script src="/js/admin-horario-trabajador.js"></script>
</body>
</html>
