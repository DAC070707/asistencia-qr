<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Trabajadores — DANA</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('../partials/header', {
    navHome: '/admin',
    navLinks: [
      { href: '/admin', texto: 'Hoy' },
      { href: '/admin/historial', texto: 'Historial' },
      { href: '/admin/trabajadores', texto: 'Trabajadores' },
      { href: '/admin/turnos', texto: 'Turnos' },
      { href: '#', texto: 'Salir', id: 'logout-link' }
    ],
    logoEmpresaUrl: logoEmpresaUrl
  }) %>

  <div class="contenedor-ancho">
    <div class="tarjeta">
      <h2>Trabajadores</h2>
      <p class="subtitulo">Click en "Horario" para fijar su horario semanal o su turno rotativo — se usa para calcular horas extra, horas pendientes y si una marcación llegó a tiempo.</p>
      <table>
        <thead>
          <tr><th>Nombre</th><th>DNI</th><th>Horario</th><th>Activo</th><th>Horas extra</th><th></th></tr>
        </thead>
        <tbody id="tabla-trabajadores">
          <tr><td colspan="6">Cargando...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script src="/js/admin-trabajadores.js"></script>
</body>
</html>
