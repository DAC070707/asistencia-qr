<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Trabajadores — DANA</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'trabajadores' }) %>

    <main class="main">
      <div class="topbar">
        <div>
          <p class="eyebrow">Equipo</p>
          <h1>Trabajadores</h1>
          <p class="topbar-sub">Click en "Configurar" para fijar horario semanal o turno rotativo.</p>
        </div>
        <div class="empresa-chip">
          <div class="avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="10" height="18" rx="1"/><path d="M14 8h6v13h-6"/><path d="M7.5 7h1M11 7h1M7.5 11h1M11 11h1M7.5 15h1M11 15h1"/></svg></div>
          <span><%= empresaNombre %></span>
        </div>
      </div>

      <div class="card">
        <div class="fila-acciones">
          <input type="text" id="buscar-input" placeholder="Buscar por nombre o DNI..." style="max-width:280px; margin:0;" />
        </div>
        <table>
          <thead>
            <tr><th>Nombre</th><th>DNI</th><th>Horario</th><th>Fecha de ingreso</th><th>Activo</th><th>Horas extra</th><th>Dispositivo</th><th></th></tr>
          </thead>
          <tbody id="tabla-trabajadores">
            <tr><td colspan="8">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script src="/js/admin-trabajadores.js"></script>
</body>
</html>
