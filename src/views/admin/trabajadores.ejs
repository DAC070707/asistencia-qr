<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Trabajadores — DANA</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'trabajadores' }) %>

    <main class="main">
      <div class="topbar">
        <div>
          <p class="eyebrow">Equipo</p>
          <h1>Trabajadores</h1>
          <p class="topbar-sub">Click en "Configurar" para fijar horario semanal o turno rotativo.</p>
        </div>
        <div class="avatar-chip">
          <div class="avatar"><%= admin.email.slice(0, 2).toUpperCase() %></div>
          <span><%= admin.email %></span>
        </div>
      </div>

      <div class="card">
        <div class="fila-acciones">
          <input type="text" id="buscar-input" placeholder="Buscar por nombre o DNI..." style="max-width:280px; margin:0;" />
        </div>
        <table>
          <thead>
            <tr><th>Nombre</th><th>DNI</th><th>Horario</th><th>Activo</th><th>Horas extra</th><th></th></tr>
          </thead>
          <tbody id="tabla-trabajadores">
            <tr><td colspan="6">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script src="/js/admin-trabajadores.js"></script>
</body>
</html>
