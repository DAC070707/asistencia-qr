<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Marcar asistencia — DANA</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('../partials/header', { logoEmpresaUrl: logoEmpresaUrl }) %>

  <div class="contenedor">
    <div class="tarjeta" style="margin-top: 24px;" data-geo-activa="<%= geolocalizacionActiva ? '1' : '0' %>">
      <h1>Hola, <%= nombre %></h1>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <div class="error" id="geo-error" hidden></div>

      <% if (horaSalida) { %>
        <p class="subtitulo exito">Jornada completa hoy.<br>Entrada: <strong><%= horaEntrada %></strong> — Salida: <strong><%= horaSalida %></strong></p>
      <% } else if (horaEntrada) { %>
        <p class="subtitulo">Entrada registrada a las <strong><%= horaEntrada %></strong>.<br>Cuando termines tu jornada, marca tu salida.</p>
      <% } else { %>
        <p class="subtitulo">Aún no has marcado nada hoy.</p>
      <% } %>

      <% if (geolocalizacionActiva) { %>
        <p class="subtitulo" style="background:var(--blue-light); color:var(--blue-dark); padding:10px 12px; border-radius:var(--radius-sm); font-size:.82rem;">
          📍 Para marcar tu asistencia verificaremos tu ubicación. Este dato se usa únicamente para control de asistencia.
        </p>
      <% } %>

      <div class="fila-acciones" style="flex-direction:column;">
        <form method="POST" action="/checkin/<%= token %>/marcar" class="form-marcar" style="width:100%;">
          <input type="hidden" name="accion" value="entrada" />
          <button type="submit" style="width:100%;" <%= horaEntrada ? 'disabled' : '' %>>
            Marcar entrada
          </button>
        </form>
        <form method="POST" action="/checkin/<%= token %>/marcar" class="form-marcar" style="width:100%; margin-top:10px;">
          <input type="hidden" name="accion" value="salida" />
          <button type="submit" class="secundario" style="width:100%;" <%= (!horaEntrada || horaSalida) ? 'disabled' : '' %>>
            Marcar salida
          </button>
        </form>
      </div>

      <p style="text-align:center; margin-top:20px;">
        <a href="/mi-historial" style="color:var(--blue); text-decoration:none; font-weight:600; font-size:0.85rem;">Ver mis horas extra y mi historial</a>
      </p>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script src="/js/checkin-marcar.js"></script>
</body>
</html>
