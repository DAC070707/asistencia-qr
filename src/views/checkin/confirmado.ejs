<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Asistencia registrada — DANA</title>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('../partials/header', { logoEmpresaUrl: logoEmpresaUrl }) %>

  <div class="contenedor">
    <div class="tarjeta" style="margin-top: 40px; text-align:center;">
      <div class="estado-icono"><%= yaExistia ? 'ℹ️' : '✅' %></div>
      <h1 class="<%= yaExistia ? '' : 'exito' %>">
        <%= yaExistia ? `Ya habías marcado tu ${tipo}` : (tipo === 'entrada' ? 'Entrada registrada' : tipo === 'salida' ? 'Salida registrada' : tipo === 'salida a refrigerio' ? 'Salida a refrigerio registrada' : 'Regreso de refrigerio registrado') %>
      </h1>
      <p class="subtitulo">Hola <strong><%= nombre %></strong>, se registró tu <%= tipo %> de hoy a las <strong><%= hora %></strong>.</p>
      <% if (estadoMarcacion) { %>
        <span class="badge badge-<%= estadoMarcacion %>">
          <% if (estadoMarcacion === 'a_tiempo') { %>A tiempo
          <% } else if (estadoMarcacion === 'tarde') { %>Tarde<% if (minutosMarcacion) { %> · <%= minutosMarcacion %> min<% } %>
          <% } else if (estadoMarcacion === 'temprano') { %>Temprano<% if (minutosMarcacion) { %> · <%= minutosMarcacion %> min<% } %>
          <% } else { %>Fuera de horario
          <% } %>
        </span>
      <% } %>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
