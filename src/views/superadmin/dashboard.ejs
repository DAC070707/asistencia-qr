<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Empresas — DANA</title>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/icon-192.png" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar', { active: 'empresas', superadmin: true }) %>

    <main class="main">
      <div class="topbar">
        <div>
          <p class="eyebrow">Súper-admin</p>
          <h1>Empresas</h1>
          <p class="topbar-sub">Administra todas las empresas cliente registradas en DANA.</p>
        </div>
      </div>

      <div class="card">
        <h2>Nueva empresa</h2>
        <div id="crear-error"></div>
        <form id="crear-form">
          <label for="nombreEmpresa">Nombre de la empresa</label>
          <input type="text" id="nombreEmpresa" required />
          <label for="adminEmail">Email del primer admin</label>
          <input type="email" id="adminEmail" required />
          <label for="adminPassword">Password del primer admin</label>
          <input type="password" id="adminPassword" required minlength="8" />
          <button type="submit" id="crear-btn">Crear empresa</button>
        </form>
      </div>

      <div class="card">
        <h2>Empresas</h2>
        <p class="card-sub"><b>Pago pendiente</b> muestra un aviso al cliente sin bloquear nada. <b>Suspendida</b> bloquea su panel y la marcación de sus trabajadores; no se borra ningún dato y al reactivarla todo vuelve igual.</p>
        <div id="empresas-error"></div>
        <table class="tabla-movil">
          <thead>
            <tr><th>Nombre</th><th>Estado de la cuenta</th><th>Trabajadores</th><th>Marcaciones</th><th>Creada</th><th>Administradores</th></tr>
          </thead>
          <tbody id="tabla-empresas">
            <tr><td colspan="6">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
      <div class="card" id="mi-cuenta">
        <h2>Mi cuenta</h2>
        <p class="card-sub">Cuenta: <strong><%= superAdmin.email %></strong>. Cambia tu contraseña cuando quieras; al hacerlo se cierran las sesiones abiertas en otros equipos.</p>
        <div id="mi-cuenta-error"></div>
        <form id="mi-cuenta-form" data-endpoint="/api/superadmin/password" class="fila-acciones" style="align-items:end;">
          <label style="margin:0; flex:1; min-width:180px;">Contraseña actual
            <input type="password" id="clave-actual" autocomplete="current-password" required style="margin:0;" />
          </label>
          <label style="margin:0; flex:1; min-width:180px;">Nueva contraseña
            <input type="password" id="clave-nueva" autocomplete="new-password" minlength="8" required style="margin:0;" />
          </label>
          <label style="margin:0; flex:1; min-width:180px;">Repite la nueva
            <input type="password" id="clave-confirmacion" autocomplete="new-password" minlength="8" required style="margin:0;" />
          </label>
          <button type="submit" id="mi-cuenta-btn">Cambiar contraseña</button>
        </form>
        <p class="card-sub" style="font-size:.8rem; margin:0;">Mínimo 8 caracteres.</p>
      </div>
    </main>
  </div>

  <script src="/js/superadmin-dashboard.js"></script>
  <script src="/js/mi-cuenta.js"></script>
</body>
</html>
