<%
  const __navItems = typeof superadmin !== 'undefined' && superadmin
    ? [{ key: 'empresas', href: '/superadmin', texto: 'Empresas', icon: 'building' }]
    : [
        { key: 'hoy', href: '/admin', texto: 'Hoy', icon: 'home' },
        { key: 'historial', href: '/admin/historial', texto: 'Historial', icon: 'history' },
        { key: 'trabajadores', href: '/admin/trabajadores', texto: 'Trabajadores', icon: 'users' },
        { key: 'turnos', href: '/admin/turnos', texto: 'Turnos', icon: 'grid' },
        { key: 'configuracion', href: '/admin/configuracion', texto: 'Configuración', icon: 'gear' },
        { key: 'usuarios', href: '/admin/usuarios', texto: 'Usuarios', icon: 'shield', solo: 'principal' }
      ];
  // Solo las secciones que el usuario puede usar (el principal ve todo).
  const __u = typeof usuario !== 'undefined' && usuario ? usuario : null;
  const __puede = function (clave) { return !__u || __u.rol === 'principal' || (__u.permisos || []).indexOf(clave) !== -1; };
  const __visibles = __navItems.filter(function (item) {
    if (!__u) return item.solo !== 'principal';
    if (item.solo === 'principal') return __u.rol === 'principal';
    if (item.key === 'trabajadores') return __puede('gestionar_trabajadores') || __puede('gestionar_horarios');
    if (item.key === 'turnos') return __puede('gestionar_horarios');
    return true;
  });
  const __icons = {
    home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5"/>',
    history: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l3 2"/><path d="M9 2h6"/>',
    users: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0"/><circle cx="17.5" cy="9" r="2.6"/><path d="M15.8 13.2a4.6 4.6 0 0 1 5.2 4.6"/>',
    grid: '<rect x="3" y="3" width="7.5" height="7.5" rx="1.6"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.6"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.6"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.6"/>',
    gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 13a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V19a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H4a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H10a1.65 1.65 0 0 0 1-1.51V4a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V10a1.65 1.65 0 0 0 1.51 1H20a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/>',
    shield: '<path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
    building: '<rect x="4" y="3" width="10" height="18" rx="1"/><path d="M14 8h6v13h-6"/><path d="M7.5 7h1M11 7h1M7.5 11h1M11 11h1M7.5 15h1M11 15h1"/>',
    logout: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>'
  };
%>
<%
  const __esSuper = typeof superadmin !== 'undefined' && superadmin;
  const __inicio = __esSuper ? '/superadmin' : '/admin';
  const __nombreEmpresa = __esSuper ? 'Súper-admin' : (typeof empresaNombre !== 'undefined' && empresaNombre ? empresaNombre : '');
%>
<!-- Solo en celular: barra superior con menu, logo, empresa y usuario -->
<header class="barra-movil">
  <button type="button" class="barra-movil-btn" id="abrir-menu" aria-label="Abrir menú" aria-controls="menu-lateral" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  </button>
  <a href="<%= __inicio %>" class="barra-movil-logo"><img src="/dana.png" alt="Dana" /></a>
  <% if (__nombreEmpresa) { %>
    <span class="barra-movil-empresa">
      <span class="barra-movil-empresa-icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- __icons.building %></svg></span>
      <span class="barra-movil-empresa-nombre"><%= __nombreEmpresa %></span>
    </span>
  <% } %>
  <div class="barra-movil-usuario">
    <button type="button" class="barra-movil-btn barra-movil-avatar" id="abrir-usuario" aria-label="Cuenta" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
    </button>
    <div class="menu-usuario" id="menu-usuario" hidden>
      <% if (__nombreEmpresa) { %><p class="menu-usuario-empresa"><%= __nombreEmpresa %></p><% } %>
      <a class="menu-usuario-opcion" href="<%= __esSuper ? '/superadmin#mi-cuenta' : '/admin/configuracion#mi-cuenta' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        Cambiar contraseña
      </a>
      <button type="button" class="menu-usuario-salir" id="salir-movil">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- __icons.logout %></svg>
        Salir
      </button>
    </div>
  </div>
</header>
<div class="menu-fondo" id="menu-fondo" hidden></div>
<% if (!__esSuper && typeof estadoCuenta !== 'undefined' && estadoCuenta === 'pago_pendiente') { %>
  <div class="aviso-cuenta aviso-cuenta-pago" data-aviso-cuenta role="status">
    <strong>Tu mensualidad de Dana está pendiente.</strong>
    Regulariza tu pago para evitar la suspensión del servicio.
  </div>
<% } %>
<% if (!__esSuper && typeof debeCambiarPassword !== 'undefined' && debeCambiarPassword) { %>
  <div class="aviso-cuenta aviso-cuenta-clave" data-aviso-cuenta role="status">
    <strong>Estás usando una contraseña temporal.</strong>
    <a href="/admin/configuracion#mi-cuenta">Crea una nueva</a> para proteger tu cuenta.
  </div>
<% } %>

<aside class="sidebar" id="menu-lateral">
  <button type="button" class="sidebar-cerrar" id="cerrar-menu" aria-label="Cerrar menú">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <a href="<%= __inicio %>" class="sidebar-brand">
    <img src="/dana.png" alt="Dana" class="sidebar-logo" />
  </a>
  <nav class="sidebar-nav">
    <% __visibles.forEach(function(item) { %>
      <a href="<%= item.href %>" class="sidebar-link<%= active === item.key ? ' active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- __icons[item.icon] %></svg>
        <span><%= item.texto %></span>
      </a>
    <% }); %>
  </nav>
  <div class="sidebar-spacer"></div>
  <div class="sidebar-promo">
    <p>Tu equipo, siempre a tiempo.</p>
  </div>
  <a href="#" id="logout-link" class="sidebar-link sidebar-logout">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- __icons.logout %></svg>
    <span>Salir</span>
  </a>
</aside>
<script>
  // Avisos de la cuenta (pago pendiente, contraseña temporal): arriba del contenido.
  document.addEventListener('DOMContentLoaded', function () {
    var main = document.querySelector('.main');
    if (!main) return;
    var avisos = document.querySelectorAll('[data-aviso-cuenta]');
    for (var i = avisos.length - 1; i >= 0; i--) main.insertBefore(avisos[i], main.firstChild);
  });

  // Celular: menu lateral deslizable y menu de usuario.
  (function () {
    var cuerpo = document.body;
    var fondo = document.getElementById('menu-fondo');
    var abrir = document.getElementById('abrir-menu');
    var menuUsuario = document.getElementById('menu-usuario');
    var botonUsuario = document.getElementById('abrir-usuario');

    function menuLateral(abierto) {
      cuerpo.classList.toggle('menu-abierto', abierto);
      fondo.hidden = !abierto;
      abrir.setAttribute('aria-expanded', String(abierto));
    }
    function usuario(abierto) {
      menuUsuario.hidden = !abierto;
      botonUsuario.setAttribute('aria-expanded', String(abierto));
    }

    abrir.addEventListener('click', function () { menuLateral(true); });
    document.getElementById('cerrar-menu').addEventListener('click', function () { menuLateral(false); });
    fondo.addEventListener('click', function () { menuLateral(false); });
    document.querySelectorAll('#menu-lateral .sidebar-link').forEach(function (a) {
      a.addEventListener('click', function () { menuLateral(false); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { menuLateral(false); usuario(false); }
    });

    botonUsuario.addEventListener('click', function (e) {
      e.stopPropagation();
      usuario(menuUsuario.hidden);
    });
    document.addEventListener('click', function (e) {
      if (!menuUsuario.hidden && !menuUsuario.contains(e.target)) usuario(false);
    });
    // "Salir" usa el mismo enlace de cierre de sesion de la barra lateral.
    document.getElementById('salir-movil').addEventListener('click', function () {
      document.getElementById('logout-link').click();
    });
  })();
</script>
