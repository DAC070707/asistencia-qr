<header class="dana-header">
  <a href="<%= typeof navHome !== 'undefined' ? navHome : '/' %>" class="dana-header-brand">
    <img src="/img/dana-logo.svg" alt="" class="dana-logo-img" />
    <span class="dana-wordmark">Dana</span>
  </a>
  <% if (typeof navLinks !== 'undefined' && navLinks) { %>
  <nav class="dana-header-nav">
    <% navLinks.forEach(function(link) { %>
      <a href="<%= link.href %>"<% if (link.id) { %> id="<%= link.id %>"<% } %>><%= link.texto %></a>
    <% }); %>
  </nav>
  <% } %>
  <% if (typeof logoEmpresaUrl !== 'undefined' && logoEmpresaUrl) { %>
    <div class="dana-header-empresa" id="dana-header-empresa">
      <img src="<%= logoEmpresaUrl %>" alt="Logo de la empresa" class="empresa-logo-img" onerror="document.getElementById('dana-header-empresa').style.display='none'" />
    </div>
  <% } %>
</header>
