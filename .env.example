# URL publica de la app (usada para construir el enlace dentro del QR)
BASE_URL=http://localhost:3000

# Conexion a Postgres (Railway/Supabase la proveen ya armada)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_db

# Secreto para firmar cookies JWT (admin y dispositivo del trabajador). Usa un valor largo y aleatorio.
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# Puerto del servidor (Railway lo inyecta automaticamente en produccion)
PORT=3000

# Datos del primer admin, usados solo por `npm run create-admin`
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=cambia-esta-password
